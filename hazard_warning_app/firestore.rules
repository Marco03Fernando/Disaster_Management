rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT ONLY: the demo app has no sign-in, so every client can read
    // and write. Replace with officer/citizen role rules (Firebase Auth +
    // custom claims) before any real deployment.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
